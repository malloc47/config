{
  "drafts": {
    "keys": { "stash": "ctrl+s", "browse": "alt+s" },
    "limit": 50,
    "restoreAfterSubmit": true
  },
  "editor": {
    "keys": { "clear": "ctrl+l", "history": "ctrl+r" },
    "backslashNewline": true,
    "historyLimit": 1000
  },
  "toolGroups": {
    "enable": true,
    "include": ["mcp__*"],
    "exclude": [],
    "labels": {}
  }
}
